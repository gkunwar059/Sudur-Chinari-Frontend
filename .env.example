# ==============================================================================
# Sudur Chinari Frontend - Environment Configuration
# Copy this file to .env and configure before starting:
#   cp .env.example .env
# ==============================================================================

# Port on host to expose the Next.js app (default: 3000)
FRONTEND_PORT=3000

# Backend URL for Server-Side Rendering (SSR) & Next.js API/Media Proxies
# - When backend is on the same VPS (in shared Docker network): http://sudur_backend:8000
# - When backend is on a separate VPS or domain: https://api.yourdomain.com
DJANGO_API_URL=http://sudur_backend:8000

# Client-Side API Base URL used by browser
# Use '/api/v1' so requests are handled transparently by Next.js API proxy,
# or specify the full domain: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Public canonical URL of this frontend website
NEXT_PUBLIC_SITE_URL=https://sudurpashchim.com

# Docker network name (matches backend if running on the same VPS)
DOCKER_NETWORK=sudur_network
